// Session 2 business-truth persistence models.
//
// The corresponding migrations are additive. These models expose command,
// event, reservation, movement, outbox, compensation and durable WhatsApp
// effect tables while legacy readers remain available during migration.

model BusinessAggregateVersion {
  aggregateType String
  aggregateId   String
  version       Int      @default(0)
  updatedAt     DateTime @default(now()) @updatedAt

  @@id([aggregateType, aggregateId])
}

model BusinessCommand {
  id                String    @id
  idempotencyKey    String    @unique
  commandType       String
  aggregateType     String
  aggregateId       String
  requestHash       String
  status            String    @default("processing")
  resultJson        String?
  actor             String
  correlationId     String
  causationId       String?
  expectedVersion   Int
  committedVersion  Int?
  createdAt         DateTime  @default(now())
  committedAt       DateTime?

  domainEvents            DomainEvent[]
  outboxIntents           OutboxIntent[]
  createdReservations     InventoryReservation[] @relation("ReservationCreatedBy")
  closedReservations      InventoryReservation[] @relation("ReservationClosedBy")
  inventoryMovements      InventoryMovement[]
  financialMovements      FinancialMovement[]
  projectionInvalidations ProjectionInvalidation[]
  compensationFacts       CompensationFact[]

  @@index([aggregateType, aggregateId, createdAt])
  @@index([commandType, createdAt])
}

model DomainEvent {
  id               String   @id
  eventKey         String   @unique
  commandId        String
  eventType        String
  aggregateType    String
  aggregateId      String
  aggregateVersion Int
  payloadJson      String
  occurredAt       DateTime @default(now())

  command BusinessCommand @relation(fields: [commandId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([aggregateType, aggregateId, aggregateVersion])
  @@index([commandId])
}

model OutboxIntent {
  id              String    @id
  effectKey       String    @unique
  commandId       String
  effectType      String
  payloadJson     String
  status          String    @default("queued")
  attemptCount    Int       @default(0)
  nextAttemptAt   DateTime?
  lockedAt        DateTime?
  leaseToken      String?
  effectStartedAt DateTime?
  lastErrorCode   String?
  outcomeState    String    @default("none")
  receiptJson     String?
  succeededAt     DateTime?
  deadLetteredAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  command BusinessCommand @relation(fields: [commandId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, nextAttemptAt])
  @@index([effectType, status, nextAttemptAt])
  @@index([status, lockedAt])
  @@index([commandId])
}

model WhatsAppOutboundEffect {
  effectKey         String   @id
  messageId         String   @unique
  providerMessageId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([providerMessageId])
}

model InventoryReservation {
  id                 String    @id
  reservationKey     String    @unique
  orderId            String
  orderItemId        String?
  productId          String
  productVariantId   String?
  quantity           Int
  state              String    @default("active")
  createdByCommandId String
  closedByCommandId  String?
  createdAt          DateTime  @default(now())
  closedAt           DateTime?

  createdByCommand BusinessCommand  @relation("ReservationCreatedBy", fields: [createdByCommandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  closedByCommand  BusinessCommand? @relation("ReservationClosedBy", fields: [closedByCommandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movements        InventoryMovement[]

  @@index([orderId, state])
  @@index([productId, productVariantId, state])
}

model InventoryMovement {
  id               String   @id
  movementKey      String   @unique
  commandId        String
  orderId          String?
  orderItemId      String?
  reservationId    String?
  productId        String
  productVariantId String?
  movementType     String
  quantity         Int
  fromPosition     String?
  toPosition       String?
  reason           String
  occurredAt       DateTime @default(now())

  command     BusinessCommand      @relation(fields: [commandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reservation InventoryReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([productId, productVariantId, occurredAt])
  @@index([orderId, occurredAt])
  @@index([commandId])
}

model FinancialMovement {
  id           String   @id
  movementKey  String   @unique
  commandId    String
  orderId      String?
  settlementId String?
  movementType String
  amount       Int
  currency     String   @default("DZD")
  counterparty String?
  reference    String?
  reason       String
  occurredAt   DateTime @default(now())

  command BusinessCommand @relation(fields: [commandId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId, occurredAt])
  @@index([settlementId, occurredAt])
  @@index([commandId])
}

model ProfitabilityCostSnapshot {
  id               String   @id
  snapshotKey      String   @unique
  commandId        String
  orderId          String
  orderItemId      String   @unique
  productId        String?
  productVariantId String?
  quantity         Int
  unitCost         Int?
  costBasis        String
  isExact          Boolean  @default(true)
  recognizedAt     DateTime
  createdAt        DateTime @default(now())

  @@index([orderId, recognizedAt])
  @@index([commandId])
}

model ProjectionInvalidation {
  id            String   @id
  commandId     String
  projectionKey String
  createdAt     DateTime @default(now())

  command BusinessCommand @relation(fields: [commandId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([commandId, projectionKey])
  @@index([projectionKey, createdAt])
}

model CompensationFact {
  id          String   @id
  factKey     String   @unique
  commandId   String
  factType    String
  payloadJson String
  createdAt   DateTime @default(now())

  command BusinessCommand @relation(fields: [commandId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([commandId])
}
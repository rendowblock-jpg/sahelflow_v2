// Phase 3 Task 6 durable commerce polling truth.
//
// Integration.config remains the compatibility watermark projection. These
// additive models own one active run per platform, provider-page continuation,
// encrypted item ingress, restart-safe leases, immutable attempts and truthful
// partial/dead-letter state. The active native shop runtime is the only worker.

model CommerceSyncRun {
  id                 String    @id
  runKey             String    @unique
  activeKey          String?   @unique
  platform           String
  integrationId      String
  sourceIdentity        String
  credentialFingerprint String    @default("")
  endpointFingerprint   String    @default("")
  status                String    @default("queued")
  initialWatermark   String
  candidateWatermark String    @default("")
  continuationCursor String?
  pagesPerCycle      Int       @default(10)
  pagesFetched       Int       @default(0)
  fetchComplete      Boolean   @default(false)
  hasMore            Boolean   @default(false)
  fetchedCount       Int       @default(0)
  createdCount       Int       @default(0)
  updatedCount       Int       @default(0)
  skippedCount       Int       @default(0)
  failedCount        Int       @default(0)
  attemptCount       Int       @default(0)
  operatorRetryCount Int       @default(0)
  nextAttemptAt      DateTime?
  lockedAt           DateTime?
  leaseToken         String?
  lastErrorCode      String?
  startedAt          DateTime?
  completedAt        DateTime?
  deadLetteredAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  pages    CommerceSyncPage[]
  items    CommerceSyncItem[]
  attempts CommerceSyncRunAttempt[]

  @@index([platform, createdAt])
  @@index([status, nextAttemptAt])
  @@index([status, lockedAt])
  @@index([integrationId, createdAt])
}

model CommerceSyncPage {
  id                 String   @id
  pageKey            String   @unique
  runId              String
  pageNumber         Int
  cursorBefore       String?
  cursorAfter        String?
  candidateWatermark String   @default("")
  itemCount          Int
  pageHash           String
  status             String   @default("persisted")
  fetchedAt          DateTime @default(now())
  createdAt          DateTime @default(now())

  run   CommerceSyncRun    @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  items CommerceSyncItem[]

  @@unique([runId, pageNumber])
  @@index([runId, fetchedAt])
}

model CommerceSyncItem {
  id                 String    @id
  itemKey            String    @unique
  runId              String
  pageId             String
  platform           String
  sourceOrderId      String
  sourceRevision     String
  payloadJson        String
  payloadHash        String
  status             String    @default("queued")
  outcome            String?
  canonicalOrderId   String?
  attemptCount       Int       @default(0)
  maxAttempts        Int       @default(5)
  operatorRetryCount Int       @default(0)
  nextAttemptAt      DateTime?
  lockedAt           DateTime?
  leaseToken         String?
  lastErrorCode      String?
  startedAt          DateTime?
  completedAt        DateTime?
  deadLetteredAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  run      CommerceSyncRun           @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  page     CommerceSyncPage          @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  attempts CommerceSyncItemAttempt[]

  @@unique([runId, sourceOrderId, sourceRevision])
  @@index([runId, status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([status, lockedAt])
  @@index([platform, sourceOrderId])
}

model CommerceSyncRunAttempt {
  id            String    @id
  runId         String
  attemptNumber Int
  phase         String
  leaseToken    String?
  state         String
  errorCode     String?
  detailJson    String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  run CommerceSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([runId, attemptNumber, phase])
  @@index([runId, startedAt])
  @@index([state, startedAt])
}

model CommerceSyncItemAttempt {
  id            String    @id
  itemId        String
  attemptNumber Int
  leaseToken    String?
  state         String
  errorCode     String?
  detailJson    String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  item CommerceSyncItem @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([itemId, attemptNumber])
  @@index([itemId, startedAt])
  @@index([state, startedAt])
}

// ─── FD-061 EX-3: Meta Pixel + Conversions API engine ────────────────────────
// Contracts extracted from CodFlow (github.com/bighadj22/codflow @ 00f18fa,
// Apache-2.0). Triggers ride the desktop outbox — never a Worker. The CAPI
// access token is NOT stored here: it rides the encrypted Secret authority
// (deliverySecretKeys-style key `meta_capi_access_token`), like every other
// provider credential.

/// Per-shop Meta Pixel configuration. One row per shop (the DB is the shop);
/// no row = CAPI disabled (safe default). The access token lives in the
/// Secret authority under `meta_capi_access_token`.
model MetaPixelConfig {
  id              String   @id
  pixelId         String
  /// Merchant's label for the Meta ad account — reference only, never sent to Meta.
  adAccountName   String?
  /// Which conversion the merchant optimizes for — chosen explicitly, never defaulted by the UI.
  conversionEvent String   @default("Purchase") // Lead | Purchase | Purchase_Confirmed | Purchase_Delivered
  /// When true, sends carry test_event_code to Meta's test stream instead of production measurement.
  testMode        Boolean  @default(false)
  testEventCode   String?
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled])
}

/// Claim + outcome ledger for CAPI sends. The UNIQUE (order, stage, event)
/// triple is the idempotency authority (create-on-conflict claim with a
/// 10-minute in-flight lease); leaseUntil doubles as the exponential-backoff
/// due time after a retryable failure.
model CapiEventLedger {
  id          String    @id
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventName   String // Lead | Purchase
  stage       String // checkout | confirmed | delivered
  eventId     String // event_id sent to Meta (= orderId) — dedups with the browser pixel
  status      String    @default("claimed") // claimed | sent | failed | skipped
  attempts    Int       @default(0)
  leaseUntil  DateTime?
  metaEventId String? // fbtrace_id from Meta (success only)
  lastError   String?
  triggeredAt DateTime
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([orderId, stage, eventName])
  @@index([status, leaseUntil])
  @@index([orderId])
}

/// Fire-and-forget audit row for every CAPI attempt/outcome. An audit write
/// failure must never propagate into order or delivery flows.
model CapiAttemptLog {
  id        String   @id
  orderId   String
  stage     String
  eventName String
  attempt   Int
  status    String // sent | failed | skipped | claimed | expired
  httpStatus Int?
  fbtraceId String?
  error     String?
  sentAt    DateTime @default(now())

  @@index([orderId, sentAt])
  @@index([sentAt])
}

/// Abandoned-cart recovery ledger (FD-061 EX-4). One row per storefront
/// visitor session with typed contact data; the UNIQUE (storefrontSlug,
/// sessionId) pair is the upsert idempotency authority. Status lifecycle:
/// pending (captured, still shopping) -> abandoned (the 30-minute sweep) or
/// converted (the session checked out; terminal and idempotent). Item
/// prices are snapshotted from the live catalog at capture time — the
/// revenue columns are recovery estimates, never money truth (orders stay
/// in the command kernel).
model AbandonedCart {
  id               String    @id @default(cuid())
  storefrontSlug   String
  sessionId        String
  customerName     String
  customerPhone    String
  wilaya           String?
  commune          String?
  address          String?
  /// JSON snapshot: [{ productId, variantId, quantity }]
  itemsJson        String
  itemCount        Int
  totalPrice       Int
  status           String    @default("pending") // pending | abandoned | converted
  capturedAt       DateTime  @default(now())
  abandonedAt      DateTime?
  convertedAt      DateTime?
  convertedOrderId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([storefrontSlug, sessionId])
  @@index([status, capturedAt])
  @@index([storefrontSlug])
}

/// Order-verified product review (FD-061 EX-4). The UNIQUE orderId is the
/// research contract: one review per real order. The buyer-facing surface
/// identifies the order by (orderNumber, phone) — the storefront never
/// exposes order UUIDs. Moderation lifecycle: pending (default) ->
/// approved | rejected; only approved reviews are publicly displayed.
model ProductReview {
  id             String    @id @default(cuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  storefrontSlug String
  authorName     String
  /// 1..5, buyer-chosen — never inferred.
  rating         Int
  body           String
  status         String    @default("pending") // pending | approved | rejected
  submittedAt    DateTime  @default(now())
  moderatedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([productId, status, submittedAt])
  @@index([storefrontSlug, status])
}

/// Quantity-tier offer (FD-061 EX-4). Per-storefront upsell configuration:
/// when the cart holds `triggerQuantity`+ of the trigger product (optionally
/// one specific variant), the buyer earns the reward — a free product line
/// (reward product/variant/quantity) or free shipping. Evaluation is
/// server-authoritative at checkout: among the eligible matches the
/// highest trigger wins, and a product reward whose live stock cannot
/// cover `rewardQuantity` is disqualified. References are live-validated
/// at evaluation time (the AbandonedCart precedent — no FK chains on
/// configuration surfaces); the reward line enters the command kernel as
/// a storefront-authoritative `unitPrice: 0` item.
model QuantityTierOffer {
  id               String   @id @default(cuid())
  storefrontSlug   String
  triggerProductId String
  /// null = every variant of the trigger product qualifies.
  triggerVariantId String?
  triggerQuantity  Int
  /// product | free_shipping
  rewardType       String
  rewardProductId  String?
  rewardVariantId  String?
  /// Required for product rewards.
  rewardQuantity   Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([storefrontSlug, isActive])
  @@index([triggerProductId, isActive])
}

// ─── FD-061 EX-4 (slice 5): per-product landing pages ────────────────────────
// Contracts extracted from CodFlow (github.com/bighadj22/codflow @ 00f18fa,
// Apache-2.0). A per-product marketing page: immutable image stack with a
// single spacing setting, views counter, attributed orders and stats
// (orders / revenue = product price only / CVR = orders ÷ views, null at
// zero views), sibling comparison per product instead of formal A/B
// experiments. A duplicate is a fresh draft with zeroed counters whose
// image rows SHARE the same immutable upload objects; image deletes are
// reference-counted so a shared object is only removed at its last
// landing-page reference. Attribution rides the order's
// sourceDetails.landingPageSlug (input-derived, so checkout replays
// converge under the command idempotency key) — the Order model is not
// modified. The productId reference is live-validated at use (the
// AbandonedCart/QuantityTierOffer precedent — no FK chains on
// configuration surfaces).

/// Per-product landing page (FD-061 EX-4). Lifecycle: draft -> published
/// (public at /storefront/<slug>/lp/<page>) -> archived; unpublish returns
/// to draft. Deletion is guarded: a page with attributed orders cannot be
/// deleted (archive it instead so history stays intact).
model LandingPage {
  id             String    @id @default(cuid())
  storefrontSlug String
  productId      String
  /// Public URL identity — unique across the shop, immutable for life.
  slug           String    @unique
  name           String
  /// draft | published | archived
  status         String    @default("draft")
  /// Pixels between stacked images — the only spacing setting.
  imageGap       Int       @default(0)
  metaTitle      String?
  metaDescription String?
  views          Int       @default(0)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  images LandingPageImage[]

  @@index([storefrontSlug, status])
  @@index([productId])
}

/// One image of a landing page's stack (FD-061 EX-4). `url` is the
/// content-addressed immutable /uploads/ object — duplicates reference the
/// SAME object, so a delete only unlinks the file at its last
/// landing-page reference (reference-counted deletes). Intrinsic width /
/// height are optional and fail-open: an image without dimensions still
/// renders, the page just cannot reserve its layout space.
model LandingPageImage {
  id            String      @id @default(cuid())
  landingPageId String
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  url           String
  altText       String?
  position      Int         @default(1)
  width         Int?
  height        Int?
  createdAt     DateTime    @default(now())

  @@index([landingPageId, position])
  @@index([url])
}

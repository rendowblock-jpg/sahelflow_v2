// ════════════════════════════════════════════════════════════════════════════
// SahelFlow — Prisma Schema (v3.0, local-first)
// ════════════════════════════════════════════════════════════════════════════
//
// ARCHITECTURE: One SQLite file per shop (max 10 shops per app install).
// There is NO seller_id column — the file IS the shop. The app opens a different
// PrismaClient instance per shop file. Shop metadata (name, icon, file path) is
// stored separately in a lightweight app-meta store, not in this schema.
//
// KEY DIFFERENCES FROM v2 (Supabase):
//   - No sellers table (app owner = the seller; config in app settings)
//   - No team_members table (team feature dropped per design system v2.0)
//   - No RLS policies (local DB, single user, no multi-tenant isolation needed)
//   - No webhook_events → renamed to PollingEvent (polling replaces webhooks)
//   - Integer money (DZD) — never Float (avoids rounding errors)
//   - Cuid IDs (no sequential integers leaking count/order)
//   - Integration credentials NOT here — stored in OS keychain
//   - No created_by/updated_by audit columns (single user)
//
// SQLCipher: This schema targets standard SQLite. Encryption (SQLCipher) is
// applied at the connection layer (Phase 0 item #5), not at the schema level.
// ════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]

  @@unique([name])
}

model Product {
  id               String     @id @default(cuid())
  name             String
  sku              String?
  price            Int
  cost             Int?
  stock            Int        @default(0)
  lowStockThreshold Int       @default(5)
  categoryId       String?
  category         Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants         String?
  images           String?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  productVariants  ProductVariant[]
  orderItems       OrderItem[]

  @@unique([sku])
  // Phase 4: reverse relation for inventory reservations
  reservations    ReservationItem[]
  deletedAt DateTime?  // soft-delete (Phase 2) — null = active
  @@index([deletedAt])

}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMERS
// ─────────────────────────────────────────────────────────────────────────────

// PII ENCRYPTION (ADR-003): name, phone, phone2, address, notes are encrypted
// at the application layer (AES-256-GCM). `phone` stores an HMAC blind index
// (deterministic, searchable, @unique); `phoneEnc` stores the encrypted actual
// phone. Callers pass plaintext — the Prisma extension in src/lib/db.ts
// encrypts on write, decrypts on read, and rewrites `where.phone` to the blind
// index. See src/lib/crypto/customer-encryption.ts.
model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  price       Int?
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]

  @@index([productId])
  @@index([isActive])
}

model Customer {
  id              String    @id @default(cuid())
  name            String
  phone           String
  phoneEnc        String?
  nameBlindIndex  String?   // SEC-009: HMAC blind index for exact-match name search
  phone2          String?
  wilaya          String?
  commune         String?
  address         String?
  orderCount      Int       @default(0)
  totalSpent      Int       @default(0)
  riskScore       Int       @default(0)
  isBlacklisted   Boolean   @default(false)  // CODE-025: dedicated column (was [BLACKLISTED] tag in notes)
  blacklistReason String?
  blacklistedAt   DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  orders          Order[]

  @@unique([phone])
  @@index([nameBlindIndex])
  @@index([isBlacklisted])
  deletedAt DateTime?  // soft-delete (Phase 2) — null = active
  @@index([deletedAt])

}

// ─────────────────────────────────────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  orderNumber     String
  status          String      @default("draft")
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  totalPrice      Int
  deliveryCost    Int?
  wilaya          String
  commune         String
  address         String
  phone           String
  phoneBlindIndex String?     // SEC-009: HMAC blind index for exact-match phone search
  source          String      @default("whatsapp")
  sourceMetadata  String?
  notes           String?
  confirmedAt     DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  delivery        Delivery?
  returns         Return[]
  orderChanges    OrderChange[]
  refunds         Refund[]
  reservations    ReservationItem[]

  @@unique([orderNumber])
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([phoneBlindIndex])
  @@index([customerId])
  // Phase 4: COD reconciliation fields (the killer feature for Algerian COD)
  codCollected      Boolean?   // did the courier collect the cash?
  codCollectedAt    DateTime?
  codRemitted       Boolean?   // has the courier remitted the cash to the seller?
  codRemittedAt     DateTime?
  codRemittanceRef  String?    // courier remittance reference number
  // Phase 4: order versioning (admin edits increment version)
  version           Int        @default(1)
  deletedAt DateTime?  // soft-delete (Phase 2) — null = active
  @@index([deletedAt])
  @@index([codRemitted])
  @@index([codCollected])

}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariantId  String?
  productVariant    ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  productName       String
  productVariantName String?
  quantity          Int
  unitPrice         Int
  total             Int

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// DELIVERIES
// ─────────────────────────────────────────────────────────────────────────────

model Delivery {
  id                String    @id @default(cuid())
  orderId           String    @unique
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String
  trackingNumber    String?
  labelUrl          String?
  cost              Int?
  status            String    @default("pending")
  estimatedDelivery DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([provider])
  deletedAt DateTime?  // soft-delete (Phase 2) — null = active
  @@index([deletedAt])

}

// ─────────────────────────────────────────────────────────────────────────────
// CONVERSATIONS & MESSAGES
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id            String    @id @default(cuid())
  channel       String
  contactName   String
  contactPhone  String?
  sourceId      String?
  lastMessageAt DateTime?
  unreadCount   Int       @default(0)
  // Phase 5: Chatwoot-style conversation workflow
  status        String    @default("open")   // "open" | "pending" | "resolved" | "snoozed"
  assigneeId    String?                          // agent assignment (future: link to User)
  priority      String?                          // "urgent" | "high" | "medium" | "low"
  teamId        String?                          // team routing (future)
  waitingSince  DateTime?                        // SLA: how long since last customer message
  firstReplyAt  DateTime?                        // first response time metric
  snoozedUntil  DateTime?                        // auto-reopen date for snoozed convos
  labels        String?                          // JSON array of label strings
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  messages      Message[]

  @@index([channel])
  @@index([lastMessageAt])
  @@index([status])
  @@index([assigneeId])
  @@index([priority])
}

model Message {
  id                 String       @id @default(cuid())
  conversationId     String
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  body               String
  direction          String
  timestamp          DateTime
  extractedOrderJson String?
  extractionMethod   String?
  // Phase 5: delivery receipts (Chatwoot pattern)
  // "sending" | "sent" | "delivered" | "read" | "failed"
  deliveryStatus     String?      @default("sent")
  // "text" | "image" | "document" | "activity" | "template"
  messageType        String       @default("text")
  // Activity message payload (for system events: "X assigned", "Resolved", etc.)
  activityType       String?
  // Attachments (JSON array of {url, type, name, size})
  attachments        String?
  createdAt          DateTime     @default(now())

  @@index([conversationId, timestamp])
  @@index([deliveryStatus])
}

// ─────────────────────────────────────────────────────────────────────────────
// RETURNS & EXCHANGES
// ─────────────────────────────────────────────────────────────────────────────

model Return {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  reason          String
  status          String    @default("requested")
  type            String
  exchangeOrderId String?
  notes           String?
  notes_rel       ReturnNote[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
  deletedAt DateTime?  // soft-delete (Phase 2) — null = active
  @@index([deletedAt])

}

model ReturnNote {
  id        String   @id @default(cuid())
  returnId  String
  return    Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([returnId])
}

// ─────────────────────────────────────────────────────────────────────────────
// FINANCE
// ─────────────────────────────────────────────────────────────────────────────

model Expense {
  id        String   @id @default(cuid())
  category  String
  amount    Int
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  @@index([date])
  @@index([category])
}

model DailyAnalyticsReport {
  id             String   @id @default(cuid())
  date           DateTime @unique
  ordersCount    Int
  revenue        Int
  confirmedCount Int
  deliveredCount Int
  returnedCount  Int
  expenses       Int
  netProfit      Int
  createdAt      DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTOMATION
// ─────────────────────────────────────────────────────────────────────────────

model Automation {
  id        String   @id @default(cuid())
  name      String
  trigger   String
  action    String
  config    String?  // JSON: action parameters (message template, status to set, etc.)
  isActive  Boolean  @default(true)
  runCount  Int      @default(0)
  lastRunAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logs      AutomationLog[]

  @@index([isActive])
  @@index([trigger])
  deletedAt DateTime?  // soft-delete (Phase 2) — null = active
  @@index([deletedAt])

}

model AutomationLog {
  id            String   @id @default(cuid())
  automationId  String
  automation    Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  trigger       String   // the event that fired (e.g. "order.delivered")
  status        String   // "success" | "failed" | "skipped"
  message       String?  // error message or skip reason
  payload       String?  // JSON: event payload snapshot (order id, customer id, etc.)
  createdAt     DateTime @default(now())

  @@index([automationId])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// INTEGRATIONS (credentials in OS keychain, NOT in this table)
// ─────────────────────────────────────────────────────────────────────────────

model Integration {
  id         String   @id @default(cuid())
  platform   String   @unique
  type       String
  isActive   Boolean  @default(false)
  lastSyncAt DateTime?
  config     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PollingEvent {
  id          String    @id @default(cuid())
  source      String
  eventId     String    @unique
  payload     String
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([source, processed])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI CHAT
// ─────────────────────────────────────────────────────────────────────────────

model AiChatSession {
  id        String         @id @default(cuid())
  title     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  AiChatMessage[]
}

model AiChatMessage {
  id        String        @id @default(cuid())
  sessionId String
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  toolCalls String?
  createdAt DateTime      @default(now())

  @@index([sessionId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// SECRETS (encrypted key/value store — ADR-003/004)
// ─────────────────────────────────────────────────────────────────────────────
// Third-party API keys (Gemini, delivery providers, e-commerce) stored
// AES-256-GCM encrypted. The master key lives outside the DB (keyfile → OS
// keychain). See src/lib/crypto/ and src/lib/secrets/.

model Secret {
  id         String   @id @default(cuid())
  key        String   @unique
  ciphertext String
  iv         String
  tag        String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// WILAYA RISK PROFILES (reference data, loaded from data/wilayas.json on init)
// ─────────────────────────────────────────────────────────────────────────────

model WilayaRiskProfile {
  id               String  @id @default(cuid())
  wilaya           String  @unique
  riskLevel        Int
  confirmationRate Float?
  returnRate       Float?
  notes            String?
}

// ─────────────────────────────────────────────────────────────────────────────
// WHATSAPP TEMPLATES
// ─────────────────────────────────────────────────────────────────────────────

model WhatsAppTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  content   String
  language  String
  category  String
  createdAt DateTime @default(now())

  @@index([language, category])
}

// ─────────────────────────────────────────────────────────────────────────────
// STOREFRONT (COD landing page builder — Phase 0 #14)
// ─────────────────────────────────────────────────────────────────────────────
// A StorefrontConfig holds the seller's mini-storefront settings (slug, theme,
// selected products, contact info). The public storefront is served at
// /storefront/[slug] — customers browse products, fill a COD form, and the
// order is created in the seller's DB via /api/storefront/submit.
//
// HOSTING (ADR-012, to be documented): in the local-first desktop model, the
// storefront is served by the Next.js app running on the seller's machine
// (localhost:3000/storefront/[slug]). For public access, the seller deploys
// the standalone Next.js build to Cloudflare Pages (free). The order-placement
// API is the same in both cases. A future PR adds a "deploy to Cloudflare"
// button that generates + uploads the static storefront.

model StorefrontConfig {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  // JSON: { template: "minimal"|"modern"|"classic", primaryColor: string, ... }
  theme       String
  // JSON: [productId, productId, ...] — which products to show
  productIds  String
  // JSON: { phone, whatsapp, email, address }
  contact     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// SETTING — non-secret app configuration (key/value, plaintext)
// ─────────────────────────────────────────────────────────────────────────────
// For secret values (API keys, tokens), use the `Secret` model instead.
// This model holds non-sensitive config like feature toggles, notification
// preferences, and report scheduling. Values are stored as strings; callers
// parse them (boolean, number, JSON) as needed.
//
// Well-known keys (convention: snake_case):
//   "daily_report_enabled"  — "true"|"false"  (daily WhatsApp report on/off)
//   "daily_report_phone"    — "213555123456"  (recipient phone, intl format)
//   "daily_report_time"     — "09:00"          (send time, HH:MM 24h, seller TZ)

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Counter — atomic sequence generator for order numbers
// ─────────────────────────────────────────────────────────────────────────────
// Used by `nextOrderNumber()` to generate race-free sequential order numbers.
// Replaces the old `db.order.count() + 1` pattern which raced on concurrent
// inserts (two concurrent storefront submits could both read count=N, both
// generate ORD-(N+1), and the second would hit @@unique([orderNumber]) and
// throw a 500 — D-005/T-011 from the AAA audit).
//
// The `upsert` + `increment` pattern translates to a single atomic
// `INSERT ... ON CONFLICT UPDATE SET value = value + 1 RETURNING value`
// in SQLite, so concurrent callers always get distinct values.
model Counter {
  name      String   @id // e.g. "ORD", "SYNC-SHOPIFY", "SYNC-WOOCOMMERCE"
  value     Int      @default(1)
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH — dedicated tables for auth secrets, sessions, and audit logs (SEC-002/004)
// ─────────────────────────────────────────────────────────────────────────────
// AuthSecret replaces the old pattern of storing auth_pin_hash + auth_secret in
// the generic Setting table (SEC-002: setSetting now rejects auth_* keys).
//
// Session enables revocation (SEC-004): tokens include a sessionId (JTI) that's
// checked against this table on every requireAuth(). Revoked sessions are
// rejected even if the HMAC signature is still valid.
//
// AuditLog records security-relevant events for forensic visibility.

model AuthSecret {
  id        String   @id @default("default") // singleton row
  pinHash   String   // PBKDF2-SHA256 hash (format: pbkdf2_sha256$iter$salt$hash)
  secret    String   // HMAC signing secret for session tokens
  updatedAt DateTime @updatedAt
}

model Session {
  id         String    @id @default(cuid())
  issuedAt   DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime? // non-null = revoked
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([revokedAt])
  @@index([issuedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  // e.g. "auth.login.success", "order.created", "order.status.changed",
  // "customer.blacklisted", "automation.fired", "settings.updated"
  action    String
  // Entity tracking (Phase 0 + Phase 4 order timeline). Optional so legacy
  // auth-only audit calls keep working without an entity context.
  entity    String?  // "order" | "customer" | "product" | "delivery" | ...
  entityId  String?  // the entity's id (e.g. order id)
  actor     String?  // who performed it ("system" | "user" | automation id) - null for legacy auth logs
  before    String?  // JSON snapshot of entity before mutation (for diff)
  after     String?  // JSON snapshot of entity after mutation
  ip        String?
  metadata  String?  // JSON string (extra context, e.g. { reason, from, to })
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([createdAt])
  @@index([entity, entityId, createdAt])  // order/customer timeline queries
}

// ─────────────────────────────────────────────────────────────────────────────
// AI EXTRACTION METRICS — tracks extraction accuracy for the "moat" (Phase 5)
// ─────────────────────────────────────────────────────────────────────────────
// Each extraction attempt records: method (regex/gemini/none), confidence,
// per-field accuracy, latency, model version. The /analytics/extraction
// dashboard aggregates this to show accuracy over time + by method.

model ExtractionMetric {
  id             String   @id @default(cuid())
  messageId      String?
  method         String   // "regex" | "gemini" | "none"
  confidence     Float    // 0.0 - 1.0
  isComplete     Boolean
  missingFields  String?  // JSON array of missing field names
  fieldAccuracy  String?  // JSON: { phone: true, name: false, ... }
  latencyMs      Int
  modelVersion   String?
  createdAt      DateTime @default(now())

  @@index([method, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 4: COMMERCE ENGINE — Order change ledger + Refunds + Reservations
// ─────────────────────────────────────────────────────────────────────────────

/// Order change ledger (Medusa pattern) — append-only audit trail of every
/// mutation on an order. Powers the order detail timeline.
model OrderChange {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // "pending" | "requested" | "confirmed" | "declined" | "canceled"
  status        String   @default("confirmed")
  // "item_add" | "item_remove" | "item_update" | "status_change" |
  // "fulfill" | "ship" | "deliver" | "return" | "refund" | "edit" | "cancel"
  actionType    String
  // Who initiated the change
  actor         String   @default("user")
  // JSON snapshot of the change payload (before/after, reason, etc.)
  payload       String?
  // Who confirmed/declined (for edit-then-confirm flow)
  confirmedBy   String?
  declinedBy    String?
  declinedReason String?
  createdAt     DateTime @default(now())
  confirmedAt   DateTime?

  @@index([orderId, createdAt])
  @@index([actionType, createdAt])
}

/// Refund — records money returned to the customer (partial or full).
model Refund {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Int
  // "cash" | "credit" | "bank" | "courier_deduction"
  method      String
  reason      String?
  // Links to a Return if the refund originated from a return
  returnId    String?
  createdBy   String   @default("user")
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([returnId])
}

/// Inventory reservation — soft-holds stock between order creation and
/// fulfillment. available = stocked - reserved. Restocked on cancel.
model ReservationItem {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quantity    Int
  createdAt   DateTime @default(now())
  // Released when the fulfillment is created (stock decremented) or order cancelled
  releasedAt  DateTime?

  @@index([productId])
  @@index([orderId])
  @@index([releasedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 5: INBOX — Canned responses (saved replies)
// ─────────────────────────────────────────────────────────────────────────────

model CannedResponse {
  id          String   @id @default(cuid())
  shortCode   String   @unique  // e.g. "welcome", "hours", "address"
  content     String              // the message text (with optional {{variables}})
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shortCode])
}

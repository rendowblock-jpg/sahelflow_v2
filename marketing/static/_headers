/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-WTeljniK9I2gqdZ8TSG/vGjsOmjTU+adRzi5W6VymLM=' 'sha256-RWhmPLwAsLnkXoAlutlolD+CB8CqT//IV3DVfGhiudo=' 'inline-speculation-rules'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/assets/*
  Cache-Control: public, max-age=300, must-revalidate

/img/*
  Cache-Control: public, max-age=604800

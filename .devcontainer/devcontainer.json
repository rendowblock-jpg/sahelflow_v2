{
  "name": "SahelFlow",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "pnpmVersion": "none"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest",
      "profile": "minimal",
      "components": "rust-analyzer,rust-src,rustfmt,clippy"
    }
  },
  "containerEnv": {
    "SF_TEST_ROOT": "/tmp/sahelflow-test",
    "SF_DATA_DIR": "/tmp/sahelflow-test/data",
    "DATABASE_URL": "file:/tmp/sahelflow-test/data/shops/test.db",
    "SF_TEST_FAIL_FAST": "1",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "SahelFlow Web",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": ["bash", ".devcontainer/post-create.sh"],
  "postStartCommand": ["bash", ".devcontainer/post-start.sh"],
  "customizations": {
    "vscode": {
      "extensions": [
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint",
        "oven.bun-vscode",
        "Prisma.prisma"
      ]
    }
  }
}

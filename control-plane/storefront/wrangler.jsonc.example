{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sahelflow-storefront",
  "main": "worker.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // React must be bundled in its production build (smaller, faster to render).
  "define": { "process.env.NODE_ENV": "\"production\"" },
  // The shared storefront renderer imports this module by name. In the Worker
  // it is replaced by a small server-side version (web/shims). Do not remove.
  "alias": {
    "@/components/storefront/storefront-locale-provider": "./web/shims/storefront-locale-provider.tsx"
  },
  // The page stylesheet is a static asset: served by Cloudflare without
  // running the Worker, so it costs nothing against the request budget.
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sahelflow-storefront",
      "database_id": "replace-with-production-d1-id"
    }
  ],
  "services": [
    {
      "binding": "CONTROL",
      "service": "sahelflow-connected"
    }
  ],
  "ratelimits": [
    {
      "name": "CHECKOUT_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }

  // Bind only verified SahelFlow-owned storefront/custom domains in production.
  // Public artifacts are data-only JSON. Arbitrary seller JavaScript/HTML is not
  // accepted, and customer PII reaches D1 only as desktop-key ciphertext.
}

name = "sahelflow-licensing"
main = "worker.ts"
compatibility_date = "2026-08-01"
workers_dev = false

# Production must attach an actual SahelFlow-owned Cloudflare zone hostname as a
# Custom Domain. Do not use the workers.dev route as customer licensing authority.
# Example only — replace with an owned production hostname before deployment:
# [[routes]]
# pattern = "license.<sahelflow-owned-zone>"
# custom_domain = true

[[d1_databases]]
binding = "DB"
database_name = "sahelflow-licensing"
database_id = "replace-with-production-d1-id"

[vars]
TRIAL_KEY_ID = "trial-2026-01"
# Raw 32-byte Ed25519 public key in base64. This is intentionally public and
# must correspond to TRIAL_PRIVATE_KEY_PKCS8 and the client keyring used by the
# signed candidate; /healthz signs + verifies a fixed readiness challenge.
TRIAL_PUBLIC_KEY = "replace-with-base64-raw-ed25519-public-key"
PRODUCT_MAJOR = "1"
TRIAL_SHOP_SLOTS = "1"
TRIAL_MEMBER_LIMIT = "25"
TRIAL_BACKUP_BYTES = "20000000000"

[[ratelimits]]
name = "TRIAL_RATE_LIMITER"
namespace_id = "1001"

[ratelimits.simple]
limit = 10
period = 60

[observability]
enabled = true
head_sampling_rate = 1

# Set TRIAL_PRIVATE_KEY_PKCS8 only with `wrangler secret put`.

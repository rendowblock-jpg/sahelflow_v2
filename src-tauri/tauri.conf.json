{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SahelFlow",
  "version": "1.0.0-internal.1",
  "identifier": "com.sahelflow.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run src-tauri/build-frontend.ts",
    "frontendDist": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "SahelFlow",
        "url": "data:text/html;charset=utf-8,%3C!doctype%20html%3E%3Ctitle%3ESahelFlow%3C%2Ftitle%3E",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:* https://generativelanguage.googleapis.com https://api.yalidine.app https://api.youcan.shop https://*.myshopify.com https://backend.maystro-delivery.com https://b.maystro-delivery.com https://procolis.com https://*.ingest.sentry.io https://*.sentry.io; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/sahelflow-whatsapp"
    ],
    "resources": {
      "../prisma/": "prisma/",
      "resources/standalone/": "standalone/",
      "resources/runtime/": "runtime/"
    },
    "windows": {
      "wix": {
        "version": "1.0.0.1"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/rendowblock-jpg/sahelflow_v2/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3MTgzNjkzQTA1ODlCNTUKUldSVm0xaWdrellZeDNWZ3BYU2xmakFsR0VQQkNQY1Y2VGxpN0F4bm5ib2kzT0xPb2cyMnlaRG0K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

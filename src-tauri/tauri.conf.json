{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SahelFlow",
  "version": "3.2.0",
  "identifier": "com.sahelflow.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run src-tauri/build-frontend.ts",
    "frontendDist": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "SahelFlow",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com https://api.yalidine.app https://api.youcan.shop https://*.myshopify.com https://backend.maystro-delivery.com https://b.maystro-delivery.com https://procolis.com ws://127.0.0.1:3001 ws://localhost:3001; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "resources": []
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/rendowblock-jpg/sahelflow_v2/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3MTgzNjkzQTA1ODlCNTUKUldSVm0xaWdrellZeDNWZ3BYU2xmakFsR0VQQkNQY1Y2VGxpN0F4bm5ib2kzT0xPb2cyMnlaRG0K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
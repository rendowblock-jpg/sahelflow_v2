# 1. Supabase Config (Required)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. AI Agentic Engine (Required)
# Fallback key used when a per-model key is not set
GROQ_API_KEY=gsk_...

# 2a. Per-Model API Keys (Recommended for rate-limit isolation)
# Each model gets its own Groq key — if one hits rate limits, the others keep working
# Go to console.groq.com → API Keys → create a key for each model
GROQ_API_KEY_BRAIN=gsk_...       # meta-llama/llama-4-scout-17b-16e-instruct
GROQ_API_KEY_FLASH=gsk_...       # llama-3.1-8b-instant
GROQ_API_KEY_DEEP=gsk_...        # openai/gpt-oss-120b
GROQ_API_KEY_STRUCT=gsk_...      # qwen/qwen3-32b
GROQ_API_KEY_CRAFT=gsk_...       # llama-3.3-70b-versatile

# 3. Evolution API Config (Required for WhatsApp Inbox)
# Point this to your Evolution API instance (Oracle Cloud Free Tier recommended)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-global-evolution-api-key

# 4. App URL (Required for Webhook Callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 5. Security
# Validates incoming Evolution API webhook requests
EVOLUTION_WEBHOOK_SECRET=your-webhook-secret
# Authenticates internal webhook calls between services
INTERNAL_WEBHOOK_SECRET=your-internal-secret

# 6. Shopify Webhook (optional — for Shopify integration)
SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-secret

# 6a. WooCommerce Integration (optional — for WooCommerce catalog sync)
# Store URL should be the WordPress site root (e.g., https://mystore.com)
# Get keys: WP Admin → WooCommerce → Settings → Advanced → REST API → Add Key
# Required scopes: read
WOOCOMMERCE_STORE_URL=https://your-store.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret

# 8. Cron Secret (required for cron endpoints)
# Protects /api/delivery/sync-tracking and /api/webhooks/retry.
CRON_SECRET=your-cron-secret

# 9. Health endpoint gate (fail-closed hardening)
# If set, /api/health returns generic {status:"ok"} for unauthenticated calls.
HEALTH_SECRET=your-health-secret

# 10. Admin endpoint secret (dead-letters auth)
# Protects dead-letter dashboard endpoints.
ADMIN_SECRET=your-admin-secret

# 11. Yalidine Delivery (optional — for shipment creation/tracking)
YALIDINE_API_KEY=your-yalidine-api-key
YALIDINE_API_TOKEN=your-yalidine-api-token

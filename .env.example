# SahelFlow — Environment Variables
# Copy this file to .env.local and fill in the values you need.

# ── Database ──────────────────────────────────────────────────────────────
# SQLite database URL (file: protocol). One file per shop.
DATABASE_URL="file:./data/shops/dev.db"

# ── Auth ──────────────────────────────────────────────────────────────────
# Optional development override for HMAC session signing. Setup stores the
# canonical secret in the active shop database; no data/auth-secret file is read.
# AUTH_SECRET=

# ── License ───────────────────────────────────────────────────────────────
# Versioned Ed25519 public keyrings as JSON objects keyed by key ID.
# Trial private keys exist only as Cloudflare Worker secrets. The permanent
# private key remains offline and outside this repository.
# SF_LICENSE_TRIAL_PUBLIC_KEYS={"trial-2026-01":"base64-public-key"}
# SF_LICENSE_PERMANENT_PUBLIC_KEYS={"permanent-2026-01":"base64-public-key"}
# SF_LICENSE_SERVICE_URL=https://licensing.example.workers.dev
# Local development only; packaged builds never enable this bypass.
# SF_LICENSE_DEVELOPMENT_BYPASS=true

# ── Connected platform ──────────────────────────────────────────────────────
# Public HTTPS origins only. Workspace bearer tokens and receipt private keys
# are enrolled into the active shop's encrypted Secret authority, never here.
# SF_CONNECTED_CONTROL_ORIGIN=https://control.example.com
# SF_CONNECTED_STOREFRONT_ORIGIN=https://storefront.example.com
# SF_CONNECTED_BACKUP_ORIGIN=https://backup.example.com
# SF_BACKUP_DIRECTORY=C:\Users\Seller\Downloads

# ── Master Key (PII Encryption) ───────────────────────────────────────────
# 32-byte master key for AES-256-GCM field encryption (64 hex chars).
# Auto-generated on first run (data/master.key). Override for tests/CI.
# SF_MASTER_KEY=

# ── Data Directory ────────────────────────────────────────────────────────
# Where app data is stored (shops, backups, whatsapp-auth, etc.)
# SF_DATA_DIR=

# ── Cron ──────────────────────────────────────────────────────────────────
# Secret for protecting /api/reports/daily (cron-triggered endpoint)
# CRON_SECRET=

# ── WhatsApp Sidecar ──────────────────────────────────────────────────────
# URL of the Baileys WhatsApp sidecar (default: http://127.0.0.1:3001)
# WHATSAPP_SIDECAR_URL=
# Bearer token for sidecar auth (auto-generated if not set)
# SIDECAR_TOKEN=

# ── Logging ───────────────────────────────────────────────────────────────
# Log level: debug | info | warn | error (default: info)
# SF_LOG_LEVEL=

# ── Delivery Provider API Bases (optional overrides) ──────────────────────
# YALIDINE_API_BASE=
# MAYSTRO_API_BASE=
# ZREXPRESS_API_BASE=
# DHD_API_BASE=

# ── Additional env vars (synced from lib/env.ts — S4-2) ───────────────────
# Public cron secret (exposed to client for cron-triggered fetches)
# NEXT_PUBLIC_CRON_SECRET=

# WhatsApp sidecar port (default: 3001)
# WHATSAPP_SIDECAR_PORT=

# App version override (default: from package.json)
# APP_VERSION=

# Sidecar token file path (auto-generated if not set)
# SIDECAR_TOKEN_FILE=

# ── Deployment / Release ───────────────────────────────────────────────────
# These are required ONLY for cutting a signed release build (Tauri installer
# + auto-update manifest + GitHub Release upload). They are NOT needed for
# local dev or for running the app from source.
#
# Tauri signing key for the auto-updater (signs the .msi/.dmg/.AppImage so
# the updater can verify integrity before installing).
# Generate with: bunx tauri signer generate -w ~/.sahelflow/tauri-updater-private.key
#   → writes the private key + prints the public key (set the public key
#      in src-tauri/tauri.conf.json > plugins.updater.pubkey).
# TAURI_SIGNING_PRIVATE_KEY=
# Password for the above private key (prompted at key-generation time).
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# GitHub PAT for `bun run release` (creates a Release + uploads the built
# installers). Needs `repo` scope on the target repo.
# Save to ~/.sahelflow/github-pat (chmod 600) OR set GITHUB_TOKEN env var.
# GITHUB_TOKEN=

# Optional: override the private-key path used by scripts/build-installer-local.ts
# (defaults to ~/.sahelflow/tauri-updater-private.key)
# TAURI_PRIVATE_KEY_PATH=

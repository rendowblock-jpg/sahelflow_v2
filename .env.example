# SahelFlow — environment variables (local-first, most config is in-app)
# Copy to .env for development. In production (Tauri), config is in-app settings.

# Database (per-shop SQLite files live in data/shops/)
# Note: SQLite 'file:' path is relative to prisma/schema.prisma location
DATABASE_URL="file:../data/shops/dev.db"

# License signing (founder's Ed25519 private key — NOT in the app bundle)
# The app only contains the PUBLIC key for verification.
LICENSE_PUBLIC_KEY=""

# App version (used for version-gating in license validation)
APP_VERSION="3.0.0"

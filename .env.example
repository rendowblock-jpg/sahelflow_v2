# SahelFlow — Environment Variables
# Copy this file to .env.local and fill in the values you need.

# ── Database ──────────────────────────────────────────────────────────────
# SQLite database URL (file: protocol). One file per shop.
DATABASE_URL="file:./data/shops/dev.db"

# ── Auth ──────────────────────────────────────────────────────────────────
# Auth secret (HMAC signing for session tokens). Auto-generated on first
# setup via /api/auth/setup. In production (Tauri), read from data/auth-secret.
# AUTH_SECRET=

# ── License ───────────────────────────────────────────────────────────────
# Ed25519 public key for verifying founder-signed licenses (base64).
# Generate with: sf-license pubkey
# LICENSE_PUBLIC_KEY=

# ── Master Key (PII Encryption) ───────────────────────────────────────────
# 32-byte master key for AES-256-GCM field encryption (64 hex chars).
# Auto-generated on first run (data/master.key). Override for tests/CI.
# SF_MASTER_KEY=

# ── Data Directory ────────────────────────────────────────────────────────
# Where app data is stored (shops, backups, whatsapp-auth, etc.)
# SF_DATA_DIR=

# ── Cron ──────────────────────────────────────────────────────────────────
# Secret for protecting /api/reports/daily (cron-triggered endpoint)
# CRON_SECRET=

# ── WhatsApp Sidecar ──────────────────────────────────────────────────────
# URL of the Baileys WhatsApp sidecar (default: http://127.0.0.1:3001)
# WHATSAPP_SIDECAR_URL=
# Bearer token for sidecar auth (auto-generated if not set)
# SIDECAR_TOKEN=

# ── Logging ───────────────────────────────────────────────────────────────
# Log level: debug | info | warn | error (default: info)
# SF_LOG_LEVEL=

# ── Delivery Provider API Bases (optional overrides) ──────────────────────
# YALIDINE_API_BASE=
# MAYSTRO_API_BASE=
# ZREXPRESS_API_BASE=
# DHD_API_BASE=

# ── Additional env vars (synced from lib/env.ts — S4-2) ───────────────────
# Public cron secret (exposed to client for cron-triggered fetches)
# NEXT_PUBLIC_CRON_SECRET=

# WhatsApp sidecar port (default: 3001)
# WHATSAPP_SIDECAR_PORT=

# App version override (default: from package.json)
# APP_VERSION=

# Sidecar token file path (auto-generated if not set)
# SIDECAR_TOKEN_FILE=

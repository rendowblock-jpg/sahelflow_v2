{
  "name": "sahelflow",
  "version": "1.0.0-internal.4",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "SahelFlow — AI-powered back-office for Algerian COD sellers. Local-first desktop app.",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:sandbox": "bun run scripts/prepare-test-sandbox.ts",
    "sf-verify": "bun run scripts/sf-verify.ts",
    "sf-audit": "bun run scripts/sf-audit.ts",
    "sf-inventory": "bun run scripts/sf-inventory.ts",
    "sf-version": "bun run scripts/sf-version.ts && bun run scripts/verify-updater-contract.ts",
    "sf-updater-contract": "bun run scripts/verify-updater-contract.ts",
    "sf-evidence": "bun run scripts/generate-evidence-manifest.ts",
    "sf-browser": "bun run sf-browser/index.ts",
    "sf-seed": "bun run sf-seed/index.ts",
    "glm:bootstrap": "bash scripts/agents/bootstrap-glm.sh",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "sidecar": "cd sidecars/whatsapp && bun run dev",
    "sidecar:start": "cd sidecars/whatsapp && bun run start",
    "tauri:dev": "bun run build:sidecar && bun run scripts/dev-sidecar-check.ts && bunx tauri dev",
    "tauri:build": "bunx tauri build",
    "seed": "bun --conditions react-server scripts/seed.ts",
    "seed:expanded": "bun --conditions react-server scripts/seed-expanded.ts",
    "postinstall": "prisma generate",
    "tauri:dev:fast": "bun run build:sidecar && bun run scripts/tauri-dev-fast.ts",
    "dev:clean": "rm -rf .next && bun run dev",
    "build:installer": "bun run scripts/build-installer-local.ts",
    "release": "bun run scripts/release.ts",
    "seed:rich": "bun --conditions react-server scripts/seed-rich.ts",
    "dev:reset": "bun run scripts/dev-reset.ts",
    "build:sidecar": "bun run scripts/build-sidecar.ts",
    "dev:web": "next dev -p 3000",
    "dev:tauri:skip-sidecar": "bunx tauri dev"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@hookform/resolvers": "^5.4.0",
    "@noble/ed25519": "^3.1.0",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "1.3.6",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "1.4.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/nextjs": "10.63.0",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-stronghold": "2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "12.42.2",
    "googleapis": "^173.0.0",
    "lucide-react": "^0.525.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "nuqs": "2.9.0",
    "papaparse": "^5.5.4",
    "radix-ui": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.80.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.6",
    "swr": "2.4.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.3",
    "@types/node": "^22",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "music-metadata": "11.14.0",
    "prisma": "^6.11.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tw-animate-css": "1.3.5",
    "typescript": "^5",
    "vitest": "^2"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "0.25.0",
    "music-metadata": "11.14.0",
    "postcss": "8.5.19",
    "uuid": "11.1.1",
    "brace-expansion": "5.0.7",
    "js-yaml": "4.3.0",
    "sharp": "0.35.3"
  },
  "workspaces": [
    "sidecars/whatsapp"
  ],
  "patchedDependencies": {
    "brace-expansion@5.0.7": "patches/brace-expansion@5.0.7.patch"
  }
}
